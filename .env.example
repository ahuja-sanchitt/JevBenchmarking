OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PRICE_IN=            # optional overrides, USD per 1M tokens
OPENAI_PRICE_CACHED=
OPENAI_PRICE_OUT=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-1.13
DATABASE_URL=sqlite+aiosqlite:///./race.db   # on Vercel: the Neon pooled URL (postgres://...?sslmode=require works as-is)
RATE_LIMIT_PER_HOUR=20
DAILY_SPEND_CAP_USD=2.00
MAX_INPUT_CHARS=600
TRUST_PROXY_HEADERS=1
OPENAI_TIMEOUT_S=90
JEV_TIMEOUT_S=30
IP_HASH_SALT=               # any long random string; keeps stored IP hashes irreversible
OPENAI_MODELS=gpt-4.1,gpt-4o-mini,gpt-6-luna,gpt-6-sol
UMAMI_WEBSITE_ID=            # optional: Umami Cloud website id; enables cookieless page analytics
